{
loopBGM(narv_story1.mp3)
volume(80)
}

scroll(s088)
showSpotMark(p88)
wait()

dialog(ワルシャワを占領しました。 $（イベント未実装）)
}

//パリ占領
event event_p5_Paris
{
scroll(s028)
showSpotMark(p2)
wait()

unionPower(p5, p2)

addUnit(Charlotte, p3)
addUnit(ly_ht_ge1, p3)
addUnit(ly_ht_ge2, p3)
addUnit(ly_ht_ge3, p3)
eraseUnit(ly_mt_ge1)
eraseUnit(ly_mt_ge2)
eraseUnit(ly_mt_ge3)
eraseUnit(ly_mt_ge4)
eraseUnit(ly_ar_ge1)
eraseUnit(ly_ar_ge2)
eraseUnit(ly_ar_ge3)
eraseUnit(ly_ar_ge4)
eraseUnit(ly_ca_ge1)
eraseUnit(ly_ca_ge2)
eraseUnit(ly_ca_ge3)
eraseUnit(ly_ca_ge4)

dialog(リゾリアが降伏しました。)
dialog(シャルロットはアヴァロンに亡命しました。)
}

//ORV援軍
event event_p3_addUnit
{
