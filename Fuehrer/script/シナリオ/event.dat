linkSpot(s064, s121, blue_route)
linkSpot(s114, s123, blue_route)
linkSpot(s118, s124, blue_route)
linkSpot(s121, s122, blue_route)
linkSpot(s122, s123, blue_route)
linkSpot(s122, s125, blue_route)
linkSpot(s123, s124, blue_route)
linkEscape(s121, s125)
linkEscape(s123, s125)

addPower(p6)

scroll(Noelle)
showSpotMark(p6)
wait()

dialog(オーヴェイン連邦が参戦しました。$ （イベント未実装）)
}

